# Copy to .env and fill in the required values.
OPENAI_API_KEY=
ANYSEARCH_API_KEY=
OPENAI_MODEL=qwen3.7-plus
# Optional dedicated model for query translation and rewriting. It shares
# OPENAI_API_KEY and OPENAI_BASE_URL with the Research Agent.
QUERY_REWRITER_MODEL=qwen3.7-flash
# Optional OpenAI-compatible endpoint. Leave empty for the default OpenAI API.
OPENAI_BASE_URL=
# The Rewriter automatically attempts the LLM for both Chinese and English
# requests whenever OPENAI_API_KEY is configured.
# Prevent a slow compatible endpoint from blocking the single research queue.
QUERY_REWRITER_TIMEOUT_SECONDS=15
QUERY_REWRITER_MAX_RETRIES=0
# Research routes narrow community tasks to Flash and broad market/competitor
# work to Plus. Both run with thinking disabled.
RESEARCH_FAST_MODEL=qwen3.7-flash
RESEARCH_BROAD_MODEL=qwen3.7-plus
# Content Planner shares OPENAI_API_KEY and OPENAI_BASE_URL with Research.
CONTENT_PLANNER_MODEL=qwen3.7-flash
CONTENT_PLANNER_TIMEOUT_SECONDS=30
CONTENT_PLANNER_MAX_RETRIES=0
CONTENT_PLANNER_MAX_TOKENS=3000
CONTENT_PLANNER_FORMAT_RETRIES=1
# Content Executor uses the same shared API configuration and is invoked once
# per plan step.
CONTENT_EXECUTOR_PREP_MODEL=qwen3.7-flash
CONTENT_EXECUTOR_PREP_TIMEOUT_SECONDS=30
CONTENT_EXECUTOR_PREP_MAX_RETRIES=0
CONTENT_EXECUTOR_PREP_MAX_TOKENS=3000
CONTENT_EXECUTOR_MODEL=qwen3.6-plus
CONTENT_EXECUTOR_TIMEOUT_SECONDS=90
CONTENT_EXECUTOR_MAX_RETRIES=0
CONTENT_EXECUTOR_MAX_TOKENS=8000
CONTENT_EXECUTOR_FORMAT_RETRIES=1
CONTENT_EXECUTOR_CONTRACT_RETRIES=1
CONTENT_EXECUTOR_PREMIUM_MODEL=qwen3.6-plus
CONTENT_EXECUTOR_PREMIUM_TIMEOUT_SECONDS=120
CONTENT_EXECUTOR_PREMIUM_MAX_RETRIES=0
CONTENT_EXECUTOR_PREMIUM_MAX_TOKENS=10000
# Two-model Reflection / Chain-of-Verification. Both reuse the shared API key
# and endpoint; the models are intentionally different across roles.
REFLECTION_QUESTION_MODEL=deepseek-v4-flash
REFLECTION_QUESTION_TIMEOUT_SECONDS=45
REFLECTION_QUESTION_MAX_RETRIES=0
REFLECTION_QUESTION_MAX_TOKENS=5000
VERIFICATION_MODEL=qwen3.7-plus
VERIFICATION_TIMEOUT_SECONDS=60
VERIFICATION_MAX_RETRIES=0
VERIFICATION_MAX_TOKENS=6000
REFLECTION_FORMAT_RETRIES=1
# Malformed structured outputs are repaired by a small native JSON model.
JSON_REPAIR_MODEL=qwen-flash
JSON_REPAIR_TIMEOUT_SECONDS=20
JSON_REPAIR_MAX_RETRIES=0
JSON_REPAIR_MAX_TOKENS=4000
# Curated brand RAG. By default embeddings share OPENAI_API_KEY and
# OPENAI_BASE_URL; use the two optional overrides only when embeddings are
# served by a different OpenAI-compatible endpoint.
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_BATCH_SIZE=20
# Three-level memory. Medium-term episodes use local SQLite; approved
# long-term assets continue to use the curated Brand RAG above.
MEMORY_ENABLED=true
MEMORY_DB_PATH=data/memory/memory.sqlite3
MEMORY_DEFAULT_BRAND_ID=smartpush
MEMORY_DEFAULT_NAMESPACE=marketing
MEMORY_MAX_ACTIVE_PER_BRAND=5000
MEMORY_PREFETCH_TOP_K=5
MEMORY_TASK_RETENTION_DAYS=180
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_MODEL=qwen3.7-text-embedding
MEMORY_EMBEDDING_TIMEOUT_SECONDS=15
# Bounded ReAct Research Agent model call settings. Tool selection stays
# automatic and Thinking is disabled by the shared model loader.
RESEARCH_AGENT_TIMEOUT_SECONDS=45
RESEARCH_AGENT_MAX_RETRIES=0
RESEARCH_AGENT_MAX_TOKENS=1000
AGENT_REACH_COMMAND_TIMEOUT_SECONDS=45
AGENT_REACH_RSS_TIMEOUT_SECONDS=15

# Feishu publishing uses the locally installed and authenticated lark-cli.
# Leave the path empty to use tools/feishu-cli first, then PATH.
FEISHU_CLI_PATH=
# Optional: bot or user. Leave empty to use the CLI's default identity.
FEISHU_CLI_IDENTITY=
FEISHU_CLI_TIMEOUT_SECONDS=60
